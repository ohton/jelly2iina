# Jellyfin Server URL
JELLYFIN_URL=http://192.168.1.100:8096

# Jellyfin API Key (Generate in Jellyfin Dashboard -> Administration -> API Keys)
JELLYFIN_API_KEY=

# Optional: Jellyfin User ID (If not set, automatically detected from server)
# JELLYFIN_USER_ID=

# Optional: Search fetch limits
# SEARCH_INTERNAL_FETCH_LIMIT=2000
# SEARCH_MAX_FETCH_LIMIT=10000
